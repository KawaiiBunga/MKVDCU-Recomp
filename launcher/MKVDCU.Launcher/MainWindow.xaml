<Window x:Class="MKVDCU.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MKVDCU-Recomp" Width="1180" Height="740"
        MinWidth="960" MinHeight="620" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C0F" Foreground="#EBE9E3" FontFamily="Segoe UI" FontSize="14">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CaptionHeight="0"
                            ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Brass" Color="#C5A977"/>
        <SolidColorBrush x:Key="Red" Color="#A9473E"/>
        <SolidColorBrush x:Key="Muted" Color="#A6A49F"/>
        <SolidColorBrush x:Key="Line" Color="#3A3C40"/>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brass}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="34"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#A9473E"/>
            <Setter Property="Foreground" Value="#FFF6EC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#E8D3AA"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#26282C"/><Setter Property="Foreground" Value="#6E6F72"/><Setter TargetName="Chrome" Property="Opacity" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="34,16"/>
            <Setter Property="MinWidth" Value="260"/>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#2A2C30"/>
            <Setter Property="Foreground" Value="#E8E6E0"/>
            <Setter Property="BorderBrush" Value="#4E5054"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Brass}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Text" Property="TextDecorations" Value="Underline"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A9A7A2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Item" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="22,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#1F2124"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Item" Property="Background" Value="#26221F"/><Setter TargetName="Item" Property="BorderBrush" Value="#A9473E"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C6C3BD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="#24262A" BorderBrush="#4E5054" BorderThickness="1" Padding="16,8" MinWidth="96" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#8E3B37"/><Setter TargetName="Box" Property="BorderBrush" Value="#C05F4E"/><Setter Property="Foreground" Value="#FFF2E3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#17191C"/>
            <Setter Property="BorderBrush" Value="#2E3034"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Background="#3A3C40" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#55575C"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Background" Value="#6A6C70"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" Margin="2,1">
                                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Foreground" Value="#E6E2DA"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E2DA"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#2A2C30"/>
            <Setter Property="Foreground" Value="#C5A977"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" BorderBrush="#4E4C49" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="#141518" MouseLeftButtonDown="TitleBar_Drag">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Border Width="8" Height="8" Background="#A9473E" Margin="0,0,10,0"/>
                    <TextBlock Text="MKVDCU-RECOMP" FontWeight="Black" FontSize="12"/>
                    <TextBlock x:Name="TitleVersion" Text="" Foreground="#7F7D78" FontSize="11" Margin="10,1,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Background="Transparent" Foreground="#A3B2C0" BorderThickness="0" ToolTip="Minimize" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Grid.Column="2" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Background="Transparent" Foreground="#A3B2C0" BorderThickness="0" ToolTip="Maximize" Click="Maximize_Click"/>
                <Button Grid.Column="3" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" ToolTip="Close" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Navigation -->
                <Border Background="#111214" BorderBrush="#26282B" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,20,0,0">
                        <RadioButton x:Name="PlayNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="play" Checked="Nav_Checked" IsChecked="True" Content="PLAY"/>
                        <RadioButton x:Name="ModsNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="mods" Checked="Nav_Checked" Content="MODS"/>
                        <RadioButton x:Name="SettingsNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="settings" Checked="Nav_Checked" Content="SETTINGS"/>
                        <RadioButton x:Name="HelpNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="help" Checked="Nav_Checked" Content="HELP"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A1B1F"/><GradientStop Color="#0C0D10" Offset="0.55"/><GradientStop Color="#15171A" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- PLAY -->
                    <Grid x:Name="PlayPanel" Margin="48,34,48,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#1D2A33" BorderBrush="#37526A" BorderThickness="1" CornerRadius="4" Padding="18,12" Margin="0,0,0,18">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Link}" Content="What's new" VerticalAlignment="Center" Margin="0,0,16,0" Click="ReleaseNotes_Click"/>
                                    <Button x:Name="UpdateButton" Style="{StaticResource Secondary}" Content="Update" Click="Update_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="UpdateText" Text="" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,36,0">
                                <TextBlock Text="MORTAL KOMBAT" FontFamily="Bahnschrift SemiCondensed" FontWeight="Black" FontStyle="Italic" FontSize="58" Foreground="#E2DED4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,-12,0,0">
                                    <TextBlock Text="VS." FontFamily="Bahnschrift SemiCondensed" FontWeight="Black" FontStyle="Italic" FontSize="60" Foreground="#A9473E"/>
                                    <TextBlock Text=" DC UNIVERSE" FontFamily="Bahnschrift SemiCondensed" FontWeight="Black" FontStyle="Italic" FontSize="60" Foreground="#C1C7CA"/>
                                </StackPanel>
                                <TextBlock Text="Unofficial PC port. Uses your own copy of the Xbox 360 game." Style="{StaticResource Body}" Margin="3,10,0,30"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PrimaryButton" Style="{StaticResource Big}" Content="PLAY" Click="Primary_Click"/>
                                    <Button x:Name="CancelButton" Style="{StaticResource Secondary}" Content="Cancel" Margin="12,0,0,0" Visibility="Collapsed" Click="Cancel_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="PrimaryHint" Text="" Style="{StaticResource Body}" Margin="3,14,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Center" Padding="26,22">
                                <StackPanel>
                                    <TextBlock Text="SETUP" Style="{StaticResource Label}" Margin="0,0,0,14"/>
                                    <Grid x:Name="StepGame" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="StepGameMark" Text="1" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Muted}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Game files" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="StepGameDetail" Text="Not chosen" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="StepTools" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="StepToolsMark" Text="2" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Muted}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Build tools" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="StepToolsDetail" Text="Checking" Style="{StaticResource Body}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="StepBuild">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="StepBuildMark" Text="3" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Muted}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PC build" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="StepBuildDetail" Text="Not built" Style="{StaticResource Body}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="0,22,0,0">
                                        <DockPanel>
                                            <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                                            <TextBlock x:Name="ProgressStage" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="Progress" Margin="0,8,0,6" Maximum="1"/>
                                        <TextBlock x:Name="ProgressDetail" Style="{StaticResource Body}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#E07A68" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                    <Button x:Name="LogToggle" Style="{StaticResource Link}" Content="Show build log" HorizontalAlignment="Left" Margin="0,16,0,0" Click="LogToggle_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="LogPanel" Grid.Row="2" Visibility="Collapsed" Height="190" Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                            <TextBox x:Name="BuildLog" Background="#0E0F11" Foreground="#CFCCC6" FontFamily="Consolas" FontSize="12" Padding="12,10"
                                     BorderThickness="0" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>

                    <!-- MODS -->
                    <ScrollViewer x:Name="ModsPanel" Visibility="Collapsed" Margin="48,34,48,20" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Mods" Style="{StaticResource Heading}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,4,0,20" Text="Mods replace the game's files without changing your copy. When two mods change the same file, the one higher in the list wins."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Button Style="{StaticResource Action}" Content="Get mods" Padding="18,9" Click="BrowseMods_Click"/>
                                <Button Style="{StaticResource Secondary}" Content="Add from file…" Margin="10,0,0,0" Click="AddMod_Click"/>
                                <Button Style="{StaticResource Secondary}" Content="Open mods folder" Margin="10,0,0,0" Click="OpenModsFolder_Click"/>
                            </StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="INSTALLED" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="InstalledMods"/>
                                    <TextBlock x:Name="NoMods" Text="No mods installed yet." Style="{StaticResource Body}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ModCatalogCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="AVAILABLE" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="ModCatalogStatus" Style="{StaticResource Body}" Text="Loading…"/>
                                    <StackPanel x:Name="ModCatalog"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SETTINGS -->
                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" Margin="48,34,48,20" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Settings" Style="{StaticResource Heading}" Margin="0,0,0,20"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="FOLDERS" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Game files" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GameFolderText" Grid.Column="1" Style="{StaticResource PathText}"/>
                                        <Button Grid.Column="2" Style="{StaticResource Secondary}" Content="Change" Tag="game" Click="ChangeFolder_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="PC build" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="InstallFolderText" Grid.Column="1" Style="{StaticResource PathText}"/>
                                        <Button Grid.Column="2" Style="{StaticResource Secondary}" Content="Change" Tag="install" Click="ChangeFolder_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Saves" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="UserFolderText" Grid.Column="1" Style="{StaticResource PathText}"/>
                                        <Button Grid.Column="2" Style="{StaticResource Secondary}" Content="Change" Tag="user" Click="ChangeFolder_Click"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Shader cache" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CacheFolderText" Grid.Column="1" Style="{StaticResource PathText}"/>
                                        <Button Grid.Column="2" Style="{StaticResource Secondary}" Content="Change" Tag="cache" Click="ChangeFolder_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="UPDATES" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="StableChannel" Style="{StaticResource Choice}" GroupName="Channel" Content="Stable" Tag="stable" Checked="Channel_Checked"/>
                                        <RadioButton x:Name="PreviewChannel" Style="{StaticResource Choice}" GroupName="Channel" Content="Preview" Tag="preview" Margin="8,0,0,0" Checked="Channel_Checked"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates when the launcher starts" Margin="0,0,0,14" Click="AutoUpdate_Click"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Secondary}" Content="Check now" Click="CheckUpdates_Click"/>
                                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="TOOLS" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource Secondary}" Content="Rebuild game" Margin="0,0,10,10" Click="Rebuild_Click"/>
                                        <Button Style="{StaticResource Secondary}" Content="Reinstall build tools" Margin="0,0,10,10" Click="ReinstallTools_Click"/>
                                        <Button Style="{StaticResource Secondary}" Content="Open logs" Margin="0,0,10,10" Click="OpenLogs_Click"/>
                                        <Button Style="{StaticResource Secondary}" Content="Desktop shortcut" Margin="0,0,10,10" Click="Shortcut_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- HELP -->
                    <ScrollViewer x:Name="HelpPanel" Visibility="Collapsed" Margin="48,34,48,20" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                            <TextBlock Text="Help" Style="{StaticResource Heading}" Margin="0,0,0,20"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="GETTING STARTED" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                                    <TextBlock Style="{StaticResource Body}" Foreground="#DDDAD3">
                                        <Run FontWeight="Bold">1.</Run> Copy the game from your own Xbox 360 disc to a folder on your PC (the folder with default.xex in it).<LineBreak/>
                                        <Run FontWeight="Bold">2.</Run> On Play, choose that folder. The launcher checks it is the supported retail version.<LineBreak/>
                                        <Run FontWeight="Bold">3.</Run> Install the build tools. Windows asks once for permission to run Microsoft's installer.<LineBreak/>
                                        <Run FontWeight="Bold">4.</Run> Build the game. The first build takes 5 to 20 minutes; updates are much faster.<LineBreak/>
                                        <Run FontWeight="Bold">5.</Run> Play.
                                    </TextBlock>
                                    <Button Style="{StaticResource Link}" Content="Step-by-step guide" Margin="0,12,0,0" HorizontalAlignment="Left" Tag="docs/GETTING_STARTED.md" Click="OpenDoc_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="IN GAME" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                                    <TextBlock Style="{StaticResource Body}" Foreground="#DDDAD3">
                                        <Run FontWeight="Bold">F1</Run> or hold <Run FontWeight="Bold">Back + Start</Run>: settings (display, graphics, controls, audio)<LineBreak/>
                                        <Run FontWeight="Bold">F2</Run>: performance overlay
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SOMETHING WRONG?" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                                    <StackPanel>
                                        <Button Style="{StaticResource Link}" Content="Troubleshooting" HorizontalAlignment="Left" Margin="0,0,0,8" Tag="docs/TROUBLESHOOTING.md" Click="OpenDoc_Click"/>
                                        <Button Style="{StaticResource Link}" Content="Report a problem" HorizontalAlignment="Left" Margin="0,0,0,8" Tag="issues/new" Click="OpenRepo_Click"/>
                                        <Button Style="{StaticResource Link}" Content="All releases" HorizontalAlignment="Left" Margin="0,0,0,8" Tag="releases" Click="OpenRepo_Click"/>
                                        <Button Style="{StaticResource Link}" Content="Making mods" HorizontalAlignment="Left" Tag="docs/MODDING.md" Click="OpenDoc_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Background="#141518">
