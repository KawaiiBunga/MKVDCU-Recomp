+void AudioSystem::PumpClient(size_t index, uint32_t& diag_pump_count) {
+  // Serialize callback selection and execution with retirement. Never wait for
+  // this lock while holding the global region: guest callbacks use that region.
+  std::unique_lock<std::recursive_mutex> callback_lock(client_callback_mutex_);
+  auto global_lock = global_critical_region_.Acquire();
+  uint32_t client_callback = clients_[index].callback;
+  uint32_t client_callback_arg = clients_[index].wrapped_callback_arg;
+  global_lock.unlock();
+
+  if (client_callback) {
+    active_callback_arg_ = client_callback_arg;
+    if (diag_pump_count < 10) {
+      REXAPU_DEBUG("AudioWorker: dispatching callback {:08X} with arg {:08X} for client {}",
+                   client_callback, client_callback_arg, index);
+    }
+    if (const GanchoAntesDeTrama gancho = g_gancho_antes_de_trama.load(std::memory_order_acquire)) {
+      gancho(index);
+    }
+    SCOPE_profile_cpu_i("apu", "rex::audio::AudioSystem->client_callback");
+    uint64_t args[] = {client_callback_arg};
+    function_dispatcher_->Execute(worker_thread_->thread_state(), client_callback, args,
+                                  rex::countof(args));
+    active_callback_arg_ = 0;
+    // A callback may unregister itself. Its wrapped argument must remain alive
+    // until guest execution returns, without waiting on that same callback.
+    if (retired_callback_arg_) {
+      auto cleanup_lock = global_critical_region_.Acquire();
+      memory()->SystemHeapFree(retired_callback_arg_);
+      retired_callback_arg_ = 0;
+    }
+    if (diag_pump_count < 10) {
+      REXAPU_DEBUG("AudioWorker: callback returned for client {}", index);
+    }
+    diag_pump_count++;
+  } else {
+    REXAPU_DEBUG("AudioWorker: semaphore signaled for client {} but callback is 0", index);
+  }
 }
 
