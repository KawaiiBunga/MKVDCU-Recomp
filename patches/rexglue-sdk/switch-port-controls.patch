@@ -0,0 +1,27 @@
+#pragma once
+#include <cstdint>
+
+namespace mkvsdcu {
+// One toggle per chord, rearmed only after BOTH buttons are released.
+struct MenuChord {
+  bool latched = false;
+  uint64_t consumed = 0;
+  bool Update(uint64_t held, uint64_t chord) {
+    consumed &= held;
+    if (!(held & chord)) latched = false;
+    if (!latched && (held & chord) == chord) {
+      latched = true;
+      consumed |= chord;
+      return true;
+    }
+    return false;
+  }
+};
+inline int16_t Deadzone(int32_t axis, int percent) {
+  const int threshold = percent * 32767 / 100;
+  const int magnitude = axis < 0 ? -axis : axis;
+  if (magnitude <= threshold) return 0;
+  const int value = (magnitude - threshold) * 32767 / (32767 - threshold);
+  return int16_t(axis < 0 ? -value : value);
+}
+}  // namespace mkvsdcu
