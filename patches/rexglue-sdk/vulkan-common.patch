diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..1bd2aa6 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -36,6 +36,10 @@
 #include <rex/system/user_module.h>
 
 REXCVAR_DEFINE_BOOL(vsync, true, "GPU", "Enable vertical sync");
+REXCVAR_DEFINE_INT32(gpu_frame_rate_limit, 0, "GPU",
+                    "Maximum guest swaps per second in normal speed mode (0 disables the limit)")
+    .range(0, 1000)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
 REXCVAR_DEFINE_BOOL(clear_memory_page_state, true, "GPU",
                     "Refresh page-valid state from GPU-written memory at frame end. "
@@ -958,6 +962,27 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   uint32_t frontbuffer_height = reader->ReadAndSwap<uint32_t>();
   reader->AdvanceRead((count - 4) * sizeof(uint32_t));
 
+  // Presentation VSync may follow a high-refresh display, or run on the UI
+  // thread without blocking this worker. Pace guest swaps independently so
+  // titles whose simulation advances per swap keep their intended speed.
+  const int32_t frame_rate_limit = REXCVAR_GET(gpu_frame_rate_limit);
+  if (REXCVAR_GET(vsync) && frame_rate_limit > 0) {
+    using Clock = std::chrono::steady_clock;
+    const auto interval = std::chrono::duration_cast<Clock::duration>(
+        std::chrono::duration<double>(1.0 / frame_rate_limit));
+    auto now = Clock::now();
+    if (next_swap_time_ == Clock::time_point{} || now > next_swap_time_ + interval) {
+      // Do not burst through missed frames after a stall or a pause.
+      next_swap_time_ = now;
+    }
+    while (worker_running_ && now < next_swap_time_) {
+      rex::thread::Sleep(next_swap_time_ - now);
+      now = Clock::now();
+    }
+    next_swap_time_ += interval;
+  } else {
+    next_swap_time_ = {};
+  }
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
 
   ++counter_;
