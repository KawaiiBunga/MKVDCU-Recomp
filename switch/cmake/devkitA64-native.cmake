# Native Windows -> Horizon. No Docker, WSL, MSYS path rewriting or registry setup.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEVKITPRO)
    if(DEFINED ENV{DEVKITPRO})
        set(DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "Portable devkitPro root")
    else()
        set(DEVKITPRO "E:/tools/devkitPro" CACHE PATH "Portable devkitPro root")
    endif()
endif()
file(TO_CMAKE_PATH "${DEVKITPRO}" DEVKITPRO)
set(_bin "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-")
if(CMAKE_HOST_WIN32)
    set(_exe ".exe")
endif()
set(CMAKE_C_COMPILER "${_bin}gcc${_exe}")
set(CMAKE_CXX_COMPILER "${_bin}g++${_exe}")
set(CMAKE_ASM_COMPILER "${_bin}gcc${_exe}")
set(CMAKE_AR "${_bin}gcc-ar${_exe}")
set(CMAKE_RANLIB "${_bin}gcc-ranlib${_exe}")
set(CMAKE_NM "${_bin}nm${_exe}" CACHE FILEPATH "Target nm")
set(CMAKE_STRIP "${_bin}strip${_exe}" CACHE FILEPATH "Target strip")
set(CMAKE_OBJCOPY "${_bin}objcopy${_exe}" CACHE FILEPATH "Target objcopy")
set(CMAKE_C_COMPILER_AR "${CMAKE_AR}")
set(CMAKE_CXX_COMPILER_AR "${CMAKE_AR}")
set(CMAKE_C_COMPILER_RANLIB "${CMAKE_RANLIB}")
set(CMAKE_CXX_COMPILER_RANLIB "${CMAKE_RANLIB}")
set(_arch "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec -fPIE -D__SWITCH__ -DNX -D_GNU_SOURCE")
set(CMAKE_C_FLAGS_INIT "${_arch} -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${_arch} -ffunction-sections -fdata-sections")
set(CMAKE_ASM_FLAGS_INIT "${_arch}")
file(READ "${DEVKITPRO}/libnx/switch.specs" _specs)
string(REPLACE "%:getenv(DEVKITPRO /libnx/switch.ld)" "${DEVKITPRO}/libnx/switch.ld" _specs "${_specs}")
# Keep generated specs inside the build, including CMake's compiler probes.
set(_specs_path "${CMAKE_BINARY_DIR}/switch-native.specs")
file(WRITE "${_specs_path}" "${_specs}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-specs=\"${_specs_path}\" -Wl,--no-relax")
include_directories(SYSTEM "${DEVKITPRO}/libnx/include" "${DEVKITPRO}/portlibs/switch/include")
link_directories("${DEVKITPRO}/libnx/lib" "${DEVKITPRO}/portlibs/switch/lib")
set(CMAKE_FIND_ROOT_PATH "${DEVKITPRO}/devkitA64" "${DEVKITPRO}/libnx" "${DEVKITPRO}/portlibs/switch")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_DL_LIBS "")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DEVKITPRO)
